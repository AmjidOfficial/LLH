APP_ENV=development
APP_NAME=LLH AI Engine
LOG_LEVEL=INFO
LLH_ENGINE_SHARED_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
LLH_ENGINE_ALLOWED_CALLBACK_HOSTS=top-fashion-leather.hatchable.site
# Keep blank until a commercially cleared local runtime is selected and installed.
LLH_VTON_RUNTIME_MODULE=
FASHN_WEIGHTS_DIR=./weights
REDIS_URL=redis://redis:6379/0
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MAX_QUEUE_DEPTH=8
JOB_TTL_SECONDS=3600
MAX_IMAGE_PIXELS=24000000
MAX_IMAGE_BYTES=12582912
REQUEST_MAX_SKEW_SECONDS=300
